{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "JobStatusWrites",
      "Effect": "Allow",
      "Action": "dynamodb:UpdateItem",
      "Resource": "arn:aws:dynamodb:__REGION__:__ACCOUNT_ID__:table/LyraLearnTable"
    },
    {
      "Sid": "RunOwnProcessingJobsOnly",
      "Effect": "Allow",
      "Action": ["sagemaker:CreateProcessingJob", "sagemaker:DescribeProcessingJob", "sagemaker:StopProcessingJob", "sagemaker:AddTags"],
      "Resource": "arn:aws:sagemaker:__REGION__:__ACCOUNT_ID__:processing-job/lyralearn-sfn-*"
    },
    {
      "Sid": "PassOnlyTheSageMakerRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::__ACCOUNT_ID__:role/lyralearn-sagemaker-processing",
      "Condition": { "StringEquals": { "iam:PassedToService": "sagemaker.amazonaws.com" } }
    },
    {
      "Sid": "SyncIntegrationManagedRule",
      "Effect": "Allow",
      "Action": ["events:PutTargets", "events:PutRule", "events:DescribeRule"],
      "Resource": "arn:aws:events:__REGION__:__ACCOUNT_ID__:rule/StepFunctionsGetEventsForSageMakerProcessingJobsRule"
    },
    {
      "Sid": "InvokeOwnLambdasOnly",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": [
        "arn:aws:lambda:__REGION__:__ACCOUNT_ID__:function:lyralearn-translate",
        "arn:aws:lambda:__REGION__:__ACCOUNT_ID__:function:lyralearn-chunk-audio"
      ]
    }
  ]
}
