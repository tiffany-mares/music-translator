{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadJobStream",
      "Effect": "Allow",
      "Action": ["dynamodb:DescribeStream", "dynamodb:GetRecords", "dynamodb:GetShardIterator", "dynamodb:ListStreams"],
      "Resource": "arn:aws:dynamodb:__REGION__:__ACCOUNT_ID__:table/LyraLearnTable/stream/*"
    },
    {
      "Sid": "ReadSongOwnerOnly",
      "Effect": "Allow",
      "Action": "dynamodb:GetItem",
      "Resource": "arn:aws:dynamodb:__REGION__:__ACCOUNT_ID__:table/LyraLearnTable"
    },
    {
      "Sid": "ListUserConnections",
      "Effect": "Allow",
      "Action": "dynamodb:Query",
      "Resource": "arn:aws:dynamodb:__REGION__:__ACCOUNT_ID__:table/WebSocketConnections/index/GSI1"
    },
    {
      "Sid": "StaleConnectionCleanup",
      "Effect": "Allow",
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:dynamodb:__REGION__:__ACCOUNT_ID__:table/WebSocketConnections"
    },
    {
      "Sid": "PushToClients",
      "Effect": "Allow",
      "Action": "execute-api:ManageConnections",
      "Resource": "arn:aws:execute-api:__REGION__:__ACCOUNT_ID__:__WS_API_ID__/prod/POST/@connections/*"
    },
    {
      "Sid": "OwnLogsOnly",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:__REGION__:__ACCOUNT_ID__:log-group:/aws/lambda/lyralearn-ws-push*"
    }
  ]
}
