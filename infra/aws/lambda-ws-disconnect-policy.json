{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConnectionRowDelete",
      "Effect": "Allow",
      "Action": "dynamodb:DeleteItem",
      "Resource": "arn:aws:dynamodb:__REGION__:__ACCOUNT_ID__:table/WebSocketConnections"
    },
    {
      "Sid": "OwnLogsOnly",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:__REGION__:__ACCOUNT_ID__:log-group:/aws/lambda/lyralearn-ws-disconnect*"
    }
  ]
}
